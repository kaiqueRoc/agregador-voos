// Coleta o stdout de todos os containers deste projeto e envia para o Loki.
// O label `service` é o nome do serviço no compose (aggregator, provider-a...).
// O JSON dos logs não é quebrado em labels aqui: o Grafana faz isso na consulta
// (`| json`), o que mantém a cardinalidade do Loki baixa.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "project" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "agregador-voos"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.project.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
