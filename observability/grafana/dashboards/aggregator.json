          },
          "expr": "sum by (level) (count_over_time({service=\"aggregator\"} | json | label_format level=`{{ if eq .level \"20\" }}debug{{ else if eq .level \"30\" }}info{{ else if eq .level \"40\" }}warn{{ else if eq .level \"50\" }}error{{ else }}{{ .level }}{{ end }}` [1m]))",
