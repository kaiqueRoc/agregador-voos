    {
      "type": "stat",
      "title": "Buscas no período",
      "id": 2,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS \"Buscas\" FROM searches WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Voos trocados pela estratégia",
      "id": 3,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0 * sum(switched::int) / nullif(count(*), 0), 1) AS \"% dos voos\"\nFROM flight_selection_economics WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Voos em que a oferta exibida NÃO foi a mais barata, porque outra rendia mais comissão dentro da tolerância."
    },
    {
      "type": "stat",
      "title": "Comissão extra obtida",
      "id": 4,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sum(commission_uplift_cents) / 100.0 AS \"Comissão extra\"\nFROM flight_selection_economics WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Quanto a empresa ganharia a mais (se as passagens forem emitidas) por exibir a oferta escolhida em vez da mais barata."
    },
    {
      "type": "stat",
      "title": "Sobrepreço pago pelo cliente",
      "id": 5,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sum(customer_premium_cents) / 100.0 AS \"Sobrepreço\"\nFROM flight_selection_economics WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Quanto os clientes pagariam a mais em relação à oferta mais barata do mesmo voo."
    },
    {
      "type": "stat",
      "title": "R$ de comissão por R$ de sobrepreço",
      "id": 6,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(sum(commission_uplift_cents)::numeric / nullif(sum(customer_premium_cents), 0), 2) AS \"Eficiência\"\nFROM flight_selection_economics WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Eficiência da troca: acima de 1, a empresa ganha mais do que o cliente paga a mais. É o número para calibrar a tolerância."
    },
    {
      "type": "piechart",
      "title": "Voos exibidos por provider",
      "id": 7,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT selected_provider AS \"Provider\", count(*) AS \"Voos exibidos\"\nFROM flight_selection_economics WHERE $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Comissão extra × sobrepreço ao longo do tempo",
      "id": 8,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '5m'),\n       sum(commission_uplift_cents) / 100.0 AS \"Comissão extra\",\n       sum(customer_premium_cents) / 100.0 AS \"Sobrepreço ao cliente\"\nFROM flight_selection_economics WHERE $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "Quem vence quando há disputa (voos vendidos por 2+ providers)",
      "id": 9,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT cheapest_provider AS \"Mais barato era\", selected_provider AS \"Exibido\",\n       count(*) AS \"Voos\",\n       round(avg(customer_premium_cents) / 100.0, 2) AS \"Sobrepreço médio (R$)\",\n       round(avg(commission_uplift_cents) / 100.0, 2) AS \"Comissão extra média (R$)\"\nFROM flight_selection_economics\nWHERE $__timeFilter(created_at) AND offers_compared > 1\nGROUP BY 1, 2 ORDER BY 3 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "Rotas mais buscadas",
      "id": 10,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT origin || ' → ' || destination AS \"Rota\", count(*) AS \"Buscas\",\n       round(avg(flights_count)) AS \"Voos/busca\",\n       round(100.0 * avg(partial::int), 1) AS \"% parcial\"\nFROM searches WHERE $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 2 DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "Confiabilidade por provider (consultas reais, sem cache)",
      "id": 11,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT provider AS \"Provider\", count(*) AS \"Consultas\",\n       round(100.0 * avg((status = 'ok')::int), 1) AS \"% ok\",\n       round(100.0 * avg((status = 'timeout')::int), 1) AS \"% timeout\",\n       round(100.0 * avg((status = 'error')::int), 1) AS \"% erro\",\n       round(100.0 * avg((status = 'circuit_open')::int), 1) AS \"% circuito aberto\",\n       round(avg(latency_ms) FILTER (WHERE status = 'ok')) AS \"Latência média ok (ms)\",\n       sum(discarded) AS \"Registros descartados\"\nFROM search_providers p JOIN searches s ON s.id = p.search_id\nWHERE $__timeFilter(s.created_at) AND NOT p.cached\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Operação — tempo real (Prometheus)",
      "id": 12,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Buscas por segundo",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(aggregator_search_requests_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Latência do POST /search",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/search\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/search\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/search\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Com cache quente fica em milissegundos; com provider travado encosta no orçamento de 3s — nunca passa disso."
    },
    {
      "type": "stat",
      "title": "Cache hit rate",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(aggregator_cache_operations_total{result=\"hit\"}[5m])) / sum(rate(aggregator_cache_operations_total{result=~\"hit|miss\"}[5m]))",
          "legendFormat": "hit rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
